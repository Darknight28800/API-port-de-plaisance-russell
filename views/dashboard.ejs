<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('partials/head', {title: 'Tableau de bord'}) %>
</head>
<body>

<%- include('partials/nav', {active: 'dashboard'}) %>

<div class="container">

    <div class="card">
        <h2>Tableau de bord</h2>
        <div class="summary">
            <span>👤 <%= user.username %> · <%= user.email %></span>
            <span><%= user.role === 'admin' ? '🛡️ Administrateur' : '🧑‍💼 Utilisateur' %></span>
            <span>📅 <%= date %></span>
        </div>
    </div>

    <div class="card">
        <h3>Réservations en cours</h3>
        <div id="reservations-container" class="table-wrap">
            <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
            <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
            <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        </div>
    </div>

</div>

<script>
// Les données du tableau de bord proviennent d'un appel asynchrone à l'API REST.
async function loadCurrentReservations() {
    const container = document.getElementById('reservations-container')

    try {
        const response = await fetch('/reservations', { headers: { Accept: 'application/json' } })

        if (!response.ok) {
            container.classList.remove('table-wrap')
            container.innerHTML = '<p class="alert error">Impossible de charger les réservations.</p>'
            return
        }

        const reservations = await response.json()
        const now = new Date()

        const current = reservations.filter((r) => new Date(r.startDate) <= now && new Date(r.endDate) >= now)

        if (current.length === 0) {
            container.classList.remove('table-wrap')
            container.innerHTML = '<p class="empty-state">⛵ Aucune réservation en cours actuellement.</p>'
            return
        }

        const rows = current.map((r) => `
            <tr>
                <td>${r.clientName}</td>
                <td>${r.boatName}</td>
                <td><span class="badge badge-long">#${r.catwayNumber}</span></td>
                <td>${new Date(r.startDate).toLocaleDateString('fr-FR')}</td>
                <td>${new Date(r.endDate).toLocaleDateString('fr-FR')}</td>
            </tr>
        `).join('')

        container.innerHTML = `
            <table>
                <thead>
                    <tr><th>Client</th><th>Bateau</th><th>Catway</th><th>Début</th><th>Fin</th></tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        `

    } catch (err) {
        container.classList.remove('table-wrap')
        container.innerHTML = '<p class="alert error">Erreur réseau lors du chargement des réservations.</p>'
    }
}

loadCurrentReservations()
</script>

</body>
</html>
