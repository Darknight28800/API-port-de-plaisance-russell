<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('../partials/head', {title: 'Catways'}) %>
</head>
<body>

<%- include('../partials/nav', {active: 'catways'}) %>

<div class="container">
    <div class="card">
        <div class="actions" style="justify-content: space-between; margin-bottom: 1.25rem;">
            <h2 style="margin:0;">Catways</h2>
            <% if (user && user.role === 'admin') { %>
            <a href="/dashboard/catways/create" class="btn">+ Nouveau catway</a>
            <% } %>
        </div>

        <% if (catways.length === 0) { %>
            <p class="empty-state">⚓ Aucun catway pour le moment.</p>
        <% } else { %>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Numéro</th><th>Type</th><th>État</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    <% catways.forEach((catway) => { %>
                    <tr data-number="<%= catway.catwayNumber %>">
                        <td><strong>#<%= catway.catwayNumber %></strong></td>
                        <td><span class="badge badge-<%= catway.catwayType %>"><%= catway.catwayType %></span></td>
                        <td><%= catway.catwayState %></td>
                        <td class="actions">
                            <% if (user && user.role === 'admin') { %>
                            <a href="/dashboard/catways/<%= catway.catwayNumber %>/edit">Modifier</a>
                            <button class="btn danger btn-delete" data-number="<%= catway.catwayNumber %>">Supprimer</button>
                            <% } else { %>
                            <span class="muted">Lecture seule</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>
    </div>
</div>

<script src="/js/toast.js"></script>
<script>
document.querySelectorAll('.btn-delete').forEach((btn) => {
    btn.addEventListener('click', async () => {
        const number = btn.dataset.number

        if (!confirm(`Supprimer le catway n°${number} ?`)) return

        try {
            const response = await fetch(`/catways/${number}`, { method: 'DELETE' })
            const data = await response.json()

            if (!response.ok) {
                showToast(data.message, 'error')
                return
            }

            document.querySelector(`tr[data-number="${number}"]`).remove()
            showToast('Catway supprimé', 'success')
        } catch (err) {
            showToast('Erreur réseau.', 'error')
        }
    })
})
</script>

</body>
</html>
