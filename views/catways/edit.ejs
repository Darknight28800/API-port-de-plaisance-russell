<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('../partials/head', {title: 'Modifier catway'}) %>
</head>
<body>

<%- include('../partials/nav', {active: 'catways'}) %>

<div class="container">
    <div class="card" style="max-width: 480px;">
        <h2>Modifier le catway n°<%= catway.catwayNumber %></h2>

        <div id="error" class="alert error" style="display:none;"></div>

        <form id="catway-form">
            <div class="form-group">
                <label>Numéro</label>
                <input type="text" value="<%= catway.catwayNumber %>" disabled>
            </div>
            <div class="form-group">
                <label>Type</label>
                <input type="text" value="<%= catway.catwayType %>" disabled>
            </div>
            <div class="form-group">
                <label for="catwayState">État</label>
                <input type="text" id="catwayState" name="catwayState" value="<%= catway.catwayState %>" required>
            </div>
            <button type="submit" class="btn">Enregistrer</button>
            <a href="/dashboard/catways" class="btn secondary">Annuler</a>
        </form>
    </div>
</div>

<script>
document.getElementById('catway-form').addEventListener('submit', async (event) => {
    event.preventDefault()

    const errorBox = document.getElementById('error')
    errorBox.style.display = 'none'

    try {
        const response = await fetch('/catways/<%= catway.catwayNumber %>', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ catwayState: document.getElementById('catwayState').value })
        })

        const data = await response.json()

        if (!response.ok) {
            const message = data.errors ? data.errors.map(e => e.message).join(' ') : data.message
            errorBox.textContent = message
            errorBox.style.display = 'block'
            return
        }

        window.location.href = '/dashboard/catways'

    } catch (err) {
        errorBox.textContent = 'Erreur réseau.'
        errorBox.style.display = 'block'
    }
})
</script>

</body>
</html>
