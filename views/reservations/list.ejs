<!DOCTYPE html>
<html lang="fr">
<head>
<%- include('../partials/head', {title: 'Réservations'}) %>
</head>
<body>

<%- include('../partials/nav', {active: 'reservations'}) %>

<div class="container">
    <div class="card">
        <div class="actions" style="justify-content: space-between; margin-bottom: 1.25rem;">
            <h2 style="margin:0;">Réservations</h2>
            <a href="/dashboard/reservations/create" class="btn gold"><%- include('../partials/icon', {name: 'plus'}) %> Nouvelle réservation</a>
        </div>

        <% if (reservations.length === 0) { %>
            <p class="empty-state"><%- include('../partials/icon', {name: 'wave', cls: 'icon-lg'}) %> Aucune réservation pour le moment.</p>
        <% } else { %>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Client</th><th>Bateau</th><th>Catway</th><th>Début</th><th>Fin</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    <% reservations.forEach((r) => { %>
                    <tr data-id="<%= r._id %>">
                        <td><%= r.clientName %></td>
                        <td><%= r.boatName %></td>
                        <td><span class="badge badge-long">#<%= r.catwayNumber %></span></td>
                        <td><%= new Date(r.startDate).toLocaleDateString('fr-FR') %></td>
                        <td><%= new Date(r.endDate).toLocaleDateString('fr-FR') %></td>
                        <td class="actions">
                            <a href="/dashboard/reservations/<%= r.catwayNumber %>/<%= r._id %>/edit"><%- include('../partials/icon', {name: 'pencil'}) %> Modifier</a>
                            <button class="btn danger btn-delete" data-catway="<%= r.catwayNumber %>" data-id="<%= r._id %>"><%- include('../partials/icon', {name: 'trash'}) %> Supprimer</button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>
    </div>
</div>

<script src="/js/toast.js"></script>
<script>
document.querySelectorAll('.btn-delete').forEach((btn) => {
    btn.addEventListener('click', async () => {
        const { catway, id } = btn.dataset

        if (!confirm('Supprimer cette réservation ?')) return

        try {
            const response = await fetch(`/catways/${catway}/reservations/${id}`, { method: 'DELETE' })
            const data = await response.json()

            if (!response.ok) {
                showToast(data.message, 'error')
                return
            }

            document.querySelector(`tr[data-id="${id}"]`).remove()
            showToast('Réservation supprimée', 'success')
        } catch (err) {
            showToast('Erreur réseau.', 'error')
        }
    })
})
</script>

</body>
</html>
